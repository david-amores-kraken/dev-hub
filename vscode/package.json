{
  "name": "dev-hub-review",
  "displayName": "Dev Hub review",
  "description": "Review a feature from the dev hub: its plan, report and e2e results, the persona reviews, and its commits in VS Code's diff editor.",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.90.0" },
  "main": "./extension.js",
  "activationEvents": ["onUri"],
  "scripts": {
    "check": "tsc -p .",
    "test": "node --test test/",
    "package": "vsce package --allow-missing-repository --skip-license -o dev-hub-review.vsix",
    "install-extension": "npm run package && code --install-extension dev-hub-review.vsix --force"
  },
  "devDependencies": {
    "@types/node": "20.12.7",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.2.1",
    "typescript": "5.4.5"
  },
  "contributes": {
    "configuration": {
      "title": "Dev Hub review",
      "properties": {
        "devHubReview.hubUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "Where the dev hub is running. It does the work and keeps the comments."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        { "id": "devHubReview", "title": "Dev Hub review", "icon": "media/review.svg" }
      ]
    },
    "views": {
      "devHubReview": [{ "id": "devHubReview.feature", "name": "Feature" }]
    },
    "commands": [
      { "command": "devHubReview.pickBranch", "title": "Pick a branch to review", "category": "Dev Hub", "icon": "$(git-branch)" },
      { "command": "devHubReview.refresh", "title": "Refresh", "category": "Dev Hub", "icon": "$(refresh)" },
      { "command": "devHubReview.openInHub", "title": "Open in the dev hub", "category": "Dev Hub", "icon": "$(link-external)" },
      { "command": "devHubReview.openPage", "title": "Open page" },
      { "command": "devHubReview.showComment", "title": "Show comment" },
      { "command": "devHubReview.createNote", "title": "Add comment" },
      { "command": "devHubReview.replyNote", "title": "Reply" },
      { "command": "devHubReview.editNote", "title": "Edit", "icon": "$(edit)" },
      { "command": "devHubReview.deleteNote", "title": "Delete", "icon": "$(trash)" },
      { "command": "devHubReview.saveNote", "title": "Save" },
      { "command": "devHubReview.cancelSaveNote", "title": "Cancel" },
      { "command": "devHubReview.resolveThread", "title": "Resolve", "icon": "$(check)" },
      { "command": "devHubReview.reopenThread", "title": "Reopen", "icon": "$(issue-reopened)" },
      { "command": "devHubReview.address", "title": "Address", "icon": "$(tools)" },
      { "command": "devHubReview.dismiss", "title": "Dismiss", "icon": "$(circle-slash)" }
    ],
    "menus": {
      "view/title": [
        { "command": "devHubReview.pickBranch", "when": "view == devHubReview.feature", "group": "navigation@1" },
        { "command": "devHubReview.refresh", "when": "view == devHubReview.feature", "group": "navigation@2" },
        { "command": "devHubReview.openInHub", "when": "view == devHubReview.feature", "group": "navigation@3" }
      ],
      "commandPalette": [
        { "command": "devHubReview.openPage", "when": "false" },
        { "command": "devHubReview.showComment", "when": "false" },
        { "command": "devHubReview.createNote", "when": "false" },
        { "command": "devHubReview.replyNote", "when": "false" },
        { "command": "devHubReview.editNote", "when": "false" },
        { "command": "devHubReview.deleteNote", "when": "false" },
        { "command": "devHubReview.saveNote", "when": "false" },
        { "command": "devHubReview.cancelSaveNote", "when": "false" },
        { "command": "devHubReview.resolveThread", "when": "false" },
        { "command": "devHubReview.reopenThread", "when": "false" },
        { "command": "devHubReview.address", "when": "false" },
        { "command": "devHubReview.dismiss", "when": "false" }
      ],
      "comments/commentThread/context": [
        { "command": "devHubReview.createNote", "group": "inline", "when": "commentController == devhub-review && commentThreadIsEmpty" },
        { "command": "devHubReview.replyNote", "group": "inline", "when": "commentController == devhub-review && !commentThreadIsEmpty" }
      ],
      "comments/commentThread/title": [
        { "command": "devHubReview.address", "group": "navigation@1", "when": "commentController == devhub-review && commentThread =~ /finding/" },
        { "command": "devHubReview.dismiss", "group": "navigation@2", "when": "commentController == devhub-review && commentThread =~ /finding/" },
        { "command": "devHubReview.resolveThread", "group": "navigation@3", "when": "commentController == devhub-review && commentThread =~ /^open/" },
        { "command": "devHubReview.reopenThread", "group": "navigation@3", "when": "commentController == devhub-review && commentThread =~ /^resolved/" }
      ],
      "comments/comment/title": [
        { "command": "devHubReview.editNote", "group": "inline@1", "when": "commentController == devhub-review && comment =~ /^(mine|reply-mine)$/" },
        { "command": "devHubReview.deleteNote", "group": "inline@2", "when": "commentController == devhub-review && comment =~ /^(mine|finding|reply-mine)$/" }
      ],
      "comments/comment/context": [
        { "command": "devHubReview.cancelSaveNote", "group": "inline@1", "when": "commentController == devhub-review" },
        { "command": "devHubReview.saveNote", "group": "inline@2", "when": "commentController == devhub-review" }
      ]
    }
  }
}
